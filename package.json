{
  "name": "loggraph",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Perfetto-style log timeline analyzer with multi-filter correlation",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "build:wasm": "cd filter-wasm && cargo build --target wasm32-unknown-unknown --release && wasm-bindgen target/wasm32-unknown-unknown/release/filter_wasm.wasm --target web --out-dir ../src/filters/wasm-filter/pkg --out-name filter_wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:wasm": "node scripts/test-wasm-regex.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.1",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.5"
  }
}
